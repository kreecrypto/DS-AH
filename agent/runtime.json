{
  "schemaVersion": "2.4.0",
  "agentVersion": "2.4.0",
  "name": "Design Control Agent",
  "role": "orchestrator_and_quality_controller_for_figma_design_work",
  "architecture": {
    "chat": "agent_runtime_and_decision_maker",
    "github": "brain_knowledge_and_operating_contract",
    "figma": "workspace_inspect_write_verify"
  },
  "defaultWriteMode": "read-only",
  "defaultBuildMode": "REPRODUCE_WHEN_REFERENCE_EXISTS",
  "entrypoint": "agent/SYSTEM.md",
  "stateMachine": "agent/state-machine.json",
  "deepFlow": "agent/flow/design-agent-flow.json",
  "referenceRouter": "agent/reference-router.json",
  "referenceLockPolicy": "agent/reference/reference-lock.json",
  "referenceReproduce": "agent/flow/reference-reproduce.json",
  "recoveryPolicy": "agent/flow/mutation-recovery.json",
  "resumePolicy": "agent/flow/reentry-resume.json",
  "specializedSubflows": "agent/flow/specialized-subflows.json",
  "writePermission": "agent/permissions/write-permission.json",
  "skillRouter": "agent/skill-router.json",
  "productRouter": "agent/product-router.json",
  "intentRouter": "agent/router/intent.json",
  "sequence": [
    "RECEIVE_TASK",
    "ROUTE_INTENT",
    "LOAD_REQUIRED_SKILLS",
    "INSPECT_LIVE_FIGMA",
    "CAPTURE_BASELINE",
    "RETRIEVE_REFERENCE_CANDIDATES",
    "SCORE_AND_RANK_REFERENCES",
    "RESOLVE_REFERENCE_AND_AUTHORITY_LANES",
    "LOCK_REFERENCE",
    "EXTRACT_VISUAL_GRAMMAR",
    "MAP_DESIGN_SYSTEM_TO_VISUAL_ROLES",
    "RESOLVE_SCREEN_ARCHETYPE",
    "RESOLVE_COMPOSITION_KNOWLEDGE",
    "BUILD_REUSE_MAP",
    "CREATE_DESIGN_DECISION",
    "DEFINE_CHANGE_SCOPE_AND_MUTATION_BUDGET",
    "EVALUATE_WRITE_PERMISSION",
    "PRE_WRITE_REVALIDATION",
    "PLAN_FIGMA_OPERATIONS_REUSE_FIRST",
    "RUN_STRUCTURE_PASS",
    "RUN_REFERENCE_SKELETON_CHECKPOINT_WHEN_REPRODUCE",
    "RUN_COMPONENT_COMPOSITION_PASS",
    "RUN_CONTENT_STATE_PASS",
    "RUN_VISUAL_POLISH_PASS",
    "RECOVER_MUTATION_IF_NEEDED",
    "VERIFY_RESULT",
    "GENERATE_VISUAL_DELTA_RECORDS",
    "RUN_QA_01A_REFERENCE_AUTHORITY",
    "RUN_QA_01B_VISUAL_FIDELITY",
    "RUN_QA_02_TO_09",
    "RUN_QA_10_VISUAL_REGRESSION",
    "FINAL_QA_AGGREGATION",
    "PATCH_DELTAS_WITHIN_MUTATION_BUDGET_IF_AUTHORIZED",
    "REVERIFY_AFTER_PATCH",
    "EMIT_EVIDENCE_AND_RESUME_CHECKPOINT_IF_BLOCKED",
    "COMPLETE"
