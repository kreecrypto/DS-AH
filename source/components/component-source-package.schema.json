{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds-ah.local/schemas/component-source-package.schema.json",
  "title": "AH Component Source Package",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "status",
    "authority",
    "identity",
    "components",
    "governance",
    "website",
    "evidence",
    "enrichment",
    "rule"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "kind": {
      "const": "component-source-package"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SOURCE_READY",
        "BLOCKED_EMPTY_FIGMA_SOURCE"
      ]
    },
    "authority": {
      "type": "object"
    },
    "identity": {
      "type": "object"
    },
    "components": {
      "type": "array"
    },
    "governance": {
      "type": "object"
    },
    "website": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "enrichment": {
      "type": "object"
    },
    "rule": {
      "type": "string"
    }
  }
}
