{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "status": "provisional-from-figma-audit",
  "color": {
    "brand": {
      "primary": {"$type": "color", "$value": "#00008F"}
    },
    "surface": {
      "default": {"$type": "color", "$value": "#FFFFFF"},
      "subtle": {"$type": "color", "$value": "#FAFAFA"},
      "muted": {"$type": "color", "$value": "#F7F7F8"},
      "brand-subtle": {"$type": "color", "$value": "#E2EFFF"}
    },
    "status": {
      "critical": {"$type": "color", "$value": "#E3000A"}
    }
  },
  "space": {
    "4": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}},
    "8": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
    "10": {"$type": "dimension", "$value": {"value": 10, "unit": "px"}},
    "12": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
    "16": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
    "20": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}},
    "24": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}}
  },
  "radius": {
    "4": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}},
    "8": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
    "12": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
    "16": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
    "full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}}
  }
}
