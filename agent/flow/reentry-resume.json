{
  "schemaVersion": "1.1.0",
  "agentVersion": "2.4.0",
  "name": "Design Agent Resume / Re-entry Policy",
  "rule": "A BLOCKED run completes with a resume checkpoint. A later resolution resumes from the earliest invalidated stage after revalidating upstream evidence.",
  "checkpointRequired": [
    "blockedReason",
    "resumeStage",
    "taskEnvelope",
    "command",
    "productDomain",
    "target",
    "loadedSkills",
    "referenceState",
    "referenceLockState",
    "visualGrammarState",
    "designSystemMappingState",
    "designDecisionState",
    "scopeState",
    "permissionState",
    "baselineState",
    "evidenceRefs",
    "invalidatedStages"
  ],
  "mappings": {
    "BLOCKED_REFERENCE_AMBIGUOUS": {
      "resumeStage": "RESOLVE_REFERENCE",
      "invalidate": [
        "RESOLVE_REFERENCE",
        "REFERENCE_LOCK",
        "VISUAL_GRAMMAR_EXTRACTION",
        "DESIGN_SYSTEM_MAPPING",
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "BLOCKED_REFERENCE_MISSING": {
      "resumeStage": "RESOLVE_REFERENCE",
      "invalidate": [
        "RESOLVE_REFERENCE",
        "REFERENCE_LOCK",
        "VISUAL_GRAMMAR_EXTRACTION",
        "DESIGN_SYSTEM_MAPPING",
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "REFERENCE_LOCK_INVALID": {
      "resumeStage": "REFERENCE_LOCK",
      "invalidate": [
        "REFERENCE_LOCK",
        "VISUAL_GRAMMAR_EXTRACTION",
        "DESIGN_SYSTEM_MAPPING",
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "VISUAL_GRAMMAR_INCOMPLETE": {
      "resumeStage": "VISUAL_GRAMMAR_EXTRACTION",
      "invalidate": [
        "VISUAL_GRAMMAR_EXTRACTION",
        "DESIGN_SYSTEM_MAPPING",
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "DESIGN_SYSTEM_MAPPING_CONFLICT": {
      "resumeStage": "DESIGN_SYSTEM_MAPPING",
      "invalidate": [
        "DESIGN_SYSTEM_MAPPING",
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "BUSINESS_DECISION_REQUIRED": {
      "resumeStage": "DESIGN_DECISION",
      "invalidate": [
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "SCOPE_UPDATE_REQUIRED": {
      "resumeStage": "CHANGE_SCOPE",
      "invalidate": [
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "WRITE_AUTHORIZATION_REQUIRED": {
      "resumeStage": "WRITE_PERMISSION",
      "invalidate": [
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "STALE_BASELINE": {
      "resumeStage": "FIGMA_INSPECT",
      "invalidate": [
        "FIGMA_INSPECT",
        "CAPTURE_BASELINE",
        "RESOLVE_REFERENCE",
        "REFERENCE_LOCK",
        "VISUAL_GRAMMAR_EXTRACTION",
        "DESIGN_SYSTEM_MAPPING",
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "STALE_REFERENCE": {
      "resumeStage": "RESOLVE_REFERENCE",
      "invalidate": [
        "RESOLVE_REFERENCE",
        "REFERENCE_LOCK",
        "VISUAL_GRAMMAR_EXTRACTION",
        "DESIGN_SYSTEM_MAPPING",
        "DESIGN_DECISION",
        "CHANGE_SCOPE",
        "WRITE_PERMISSION",
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "TOOL_CAPABILITY_REQUIRED": {
      "resumeStage": "PRE_WRITE_REVALIDATION",
      "invalidate": [
        "PRE_WRITE_REVALIDATION",
        "FIGMA_EXECUTION_PLAN"
      ]
    },
    "MUTATION_STATE_UNKNOWN": {
      "resumeStage": "MUTATION_RECOVERY",
      "invalidate": [
        "MUTATION_RECOVERY",
        "VERIFICATION",
        "QA_PRE_REGRESSION",
        "VISUAL_REGRESSION",
        "FINAL_QA_AGGREGATION"
      ]
    },
    "QA_EVIDENCE_REQUIRED": {
      "resumeStage": "VERIFICATION",
      "invalidate": [
        "VERIFICATION",
        "QA_PRE_REGRESSION",
        "VISUAL_REGRESSION",
        "FINAL_QA_AGGREGATION"
      ]
    }
  },
  "resumeValidation": [
    "Confirm target still exists.",
    "Confirm Primary Visual Authority is still the same locked source.",
    "Confirm authority lanes have not changed.",
    "Revalidate any baseline older than a known canvas edit.",
    "Re-evaluate write permission for the current run.",
    "Record which outputs were reused vs invalidated."
  ]
}
