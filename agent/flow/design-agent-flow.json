      "CAPTURE_BASELINE",
      "RESOLVE_REFERENCE",
      "DESIGN_DECISION",
      "QA_PRE_REGRESSION",
      "VISUAL_REGRESSION",
      "FINAL_QA_AGGREGATION",
      "EVIDENCE",
      "COMPLETE"
    ],
    "CREATE_SCREEN": [
      "USER_REQUEST",
