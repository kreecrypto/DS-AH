{
  "schemaVersion": "2.2.0",
  "agentVersion": "2.2.0",
  "name": "Design Control Agent",
  "role": "orchestrator_and_quality_controller_for_figma_design_work",
  "defaultWriteMode": "read-only",
  "defaultBuildMode": "REPRODUCE_WHEN_REFERENCE_EXISTS",
  "entrypoint": "agent/SYSTEM.md",
  "stateMachine": "agent/state-machine.json",
  "writePermission": "agent/permissions/write-permission.json",
  "skillRouter": "agent/skill-router.json",
  "productRouter": "agent/product-router.json",
  "intentRouter": "agent/router/intent.json",
  "referenceRouter": "agent/reference-router.json",
  "sequence": [
    "RECEIVE_TASK",
    "ROUTE_INTENT",
    "RESOLVE_PRODUCT_DOMAIN_TARGET",
    "LOAD_REQUIRED_SKILLS",
    "INSPECT_LIVE_FIGMA_AND_REPOSITORY_EVIDENCE",
    "RESOLVE_REFERENCE_AND_SOURCE_OF_TRUTH",
    "CREATE_DESIGN_DECISION",
    "DEFINE_CHANGE_SCOPE",
    "EVALUATE_WRITE_PERMISSION",
    "PLAN_QUALITY_GATES",
    "EXECUTE_IF_WRITE_ALLOWED",
    "RUN_DESIGN_QA",
    "RUN_REFERENCE_FIDELITY",
    "RUN_VISUAL_REGRESSION_WHEN_APPLICABLE",
    "FIX_LOOP_FOR_FIXABLE_P0_P1",
    "EMIT_EVIDENCE_MATRIX",
    "COMPLETE_OR_BLOCK"
  ],
  "schemas": {
    "execution": "agent/output/execution.schema.json",
    "decisionLog": "agent/output/decision-log.schema.json",
    "designDecision": "agent/planner/design-decision.schema.json",
    "changeScope": "agent/controller/change-scope.schema.json",
    "qaResult": "agent/output/qa-result.schema.json",
    "evidenceMatrix": "agent/output/evidence-matrix.schema.json",
    "reviewResult": "agent/output/review-result.schema.json"
  },
  "qualityGates": "agent/gates/quality-gates.json",
  "invariants": [
    "figma_read_only_by_default",
    "inspect_before_write",
    "reference_before_layout",
    "plan_before_execute",
    "scope_before_execute",
    "explicit_write_signal_required",
    "reference_pass_does_not_equal_write_permission",
    "no_write_when_reference_ambiguous_or_missing",
    "master_first_when_available",
    "new_file_is_not_explore_permission",
    "reuse_before_create",
    "exact_key_before_same_name_assumption",
    "no_scope_expansion_for_visual_polish",
    "visual_compare_before_pass",
    "qa_before_complete",
    "no_pass_without_evidence",
    "fixable_p0_p1_write_failure_enters_fix_loop"
  ]
}
