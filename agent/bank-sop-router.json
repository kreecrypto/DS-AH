    "AGENTS.md",
    "agent/SYSTEM.md",
    "docs/figma-sop.md",
    "knowledge/ux/README.md"
  ],
  "rules": [
    "SOP Bank guides execution but never overrides repository hard rules.",
    "READ_ONLY review commands never imply write permission.",
    "CREATE/MODIFY/FIX still require WRITE_ALLOWED.",
    "No PASS without evidence.",
    "P0/P1 findings must be resolved or explicitly blocked before completion."
