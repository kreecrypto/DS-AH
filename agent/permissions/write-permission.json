{
  "schemaVersion": "1.1.0",
  "agentVersion": "2.4.0",
  "states": [
    "READ_ONLY",
    "INSPECT_ALLOWED",
    "WRITE_PENDING",
    "WRITE_ALLOWED",
    "WRITE_BLOCKED"
  ],
  "default": "READ_ONLY",
  "rules": {
    "INSPECT": "INSPECT_ALLOWED",
    "REVIEW": "READ_ONLY",
    "QA": "READ_ONLY",
    "HANDOFF": "READ_ONLY",
    "COMPONENT": "READ_ONLY",
    "CREATE_SCREEN": "WRITE_PENDING",
    "MODIFY_SCREEN": "WRITE_PENDING",
    "FIX": "WRITE_PENDING"
  },
  "writeAllowedRequiresAll": [
    "explicit_current_task_write_signal",
    "target_resolved",
    "scope_defined",
    "reference_gate_PASS_or_EXPLORE_EXPLICIT",
    "reference_lock_LOCKED_or_NOT_APPLICABLE",
    "figma_write_capability_available"
  ],
  "writeBlockedWhenAny": [
    "reference_gate_BLOCKED_REFERENCE_AMBIGUOUS",
    "reference_gate_BLOCKED_REFERENCE_MISSING",
    "reference_lock_BLOCKED",
    "target_unresolved",
    "scope_unresolved",
    "figma_write_capability_unavailable"
  ],
  "principles": [
    "intent_alone_never_grants_write",
    "repository_state_never_grants_write",
    "reference_gate_pass_never_bypasses_reference_lock",
    "review_and_qa_remain_read_only_until_rerouted_to_modify_or_fix",
    "permission_must_be_re_evaluated_after_scope_reference_or_lock_changes"
  ]
}
