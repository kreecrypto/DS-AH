{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent/output/execution.schema.json",
  "title": "Design Agent v2.3 Execution Envelope",
  "type": "object",
  "required": [
    "command",
    "product",
    "writeMode",
    "workflow",
    "sources",
    "loadedSkills"
  ],
  "properties": {
    "command": {
      "enum": [
        "INSPECT",
        "REVIEW",
        "QA",
        "HANDOFF",
        "COMPONENT",
        "CREATE_SCREEN",
        "MODIFY_SCREEN",
        "FIX"
      ]
    },
    "product": {
      "enum": [
        "core",
        "agency",
        "admin",
        "unknown"
      ]
    },
    "writeMode": {
      "enum": [
        "read-only",
        "explicit-write"
      ]
    },
    "buildMode": {
      "enum": [
        "REPRODUCE",
        "ADAPT",
        "EXPLORE",
        null
      ]
    },
    "referenceGate": {
      "enum": [
        "PASS",
        "BLOCKED_REFERENCE_AMBIGUOUS",
        "BLOCKED_REFERENCE_MISSING",
        "EXPLORE_EXPLICIT",
        "NOT_APPLICABLE"
      ]
    },
    "reference": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "fileKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loadedSkills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "goal": {
      "type": "string"
    },
    "baselineFingerprint": {
      "$ref": "baseline-fingerprint.schema.json"
    },
    "preWriteRevalidation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "result": {
          "enum": [
            "CURRENT",
            "STALE_BASELINE",
            "BLOCKED"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "operationPlan": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "mutation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "mutationRecovery": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "canvasWriteState": {
          "enum": [
            "NO_WRITE",
            "PARTIAL_WRITE",
            "UNKNOWN_WRITE",
            "RECOVERED"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "qaPhases": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "resumeCheckpoint": {
      "$ref": "resume-checkpoint.schema.json"
    },
    "changedScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finalResult": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    }
  },
  "additionalProperties": true
}
