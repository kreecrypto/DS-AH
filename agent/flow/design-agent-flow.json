{
  "schemaVersion": "2.0.0",
  "agentVersion": "2.3.0",
  "name": "DS-AH Design Agent Production Flow",
  "canonicalOrder": [
    "USER_REQUEST",
    "RESOLVE_INTENT",
    "LOAD_AGENT_SKILLS",
    "FIGMA_INSPECT",
    "CAPTURE_BASELINE",
    "RESOLVE_REFERENCE",
    "DESIGN_DECISION",
    "CHANGE_SCOPE",
    "WRITE_PERMISSION",
    "PRE_WRITE_REVALIDATION",
    "FIGMA_EXECUTION_PLAN",
    "MUTATION",
    "MUTATION_RECOVERY",
    "VERIFICATION",
    "QA_PRE_REGRESSION",
    "VISUAL_REGRESSION",
    "FINAL_QA_AGGREGATION",
    "FIX_LOOP",
    "EVIDENCE",
    "COMPLETE"
  ],
  "qaPhases": {
    "preRegression": [
      "QA-01",
      "QA-02",
      "QA-03",
      "QA-04",
      "QA-05",
      "QA-06",
      "QA-07",
      "QA-08",
      "QA-09"
    ],
    "regression": [
      "QA-10"
    ],
    "finalAggregationRule": "FINAL_QA_AGGREGATION may resolve only after QA-01..QA-09 and QA-10 are PASS/FAIL/BLOCKED/NOT_APPLICABLE with evidence."
  },
  "stages": [
    {
      "id": "USER_REQUEST",
      "state": "RECEIVED",
      "mode": "READ_ONLY",
      "owner": "controller",
      "gate": "TASK_PARSED",
      "requiredOutputs": [
        "taskEnvelope"
      ],
      "next": [
        "RESOLVE_INTENT"
      ]
    },
    {
      "id": "RESOLVE_INTENT",
      "state": "ROUTED",
      "mode": "READ_ONLY",
      "owner": "intent-router+product-router",
      "gate": "INTENT_RESOLVED",
      "requiredOutputs": [
        "command",
        "workflow",
        "productDomain",
        "targetCandidate",
        "defaultPermission"
      ],
      "next": [
        "LOAD_AGENT_SKILLS"
      ]
    },
    {
      "id": "LOAD_AGENT_SKILLS",
      "state": "ROUTED",
      "mode": "READ_ONLY",
      "owner": "skill-router",
      "gate": "SKILLS_READY",
      "requiredOutputs": [
        "loadedSkills",
        "versions",
        "conditionalSkills"
      ],
      "next": [
        "FIGMA_INSPECT"
      ]
    },
    {
      "id": "FIGMA_INSPECT",
      "state": "INSPECTING",
      "mode": "READ_ONLY",
      "owner": "figma-inspect",
      "gate": "INSPECTION_READY",
      "requiredOutputs": [
        "inspectionEvidence",
        "exactNodeIds",
        "componentIdentity",
        "unknowns"
      ],
      "next": [
        "CAPTURE_BASELINE",
        "EVIDENCE"
      ]
    },
    {
      "id": "CAPTURE_BASELINE",
      "state": "BASELINED",
      "mode": "READ_ONLY",
      "owner": "figma-inspect+controller",
      "gate": "BASELINE_CAPTURED",
      "requiredOutputs": [
        "baselineFingerprint",
        "authorityBaseline",
        "preservationBaseline"
      ],
      "next": [
        "RESOLVE_REFERENCE"
      ],
      "conditional": "required for write workflows and comparison-based QA; may be NOT_APPLICABLE for pure inspection"
    },
    {
      "id": "RESOLVE_REFERENCE",
      "state": "REFERENCE_RESOLVED",
      "mode": "READ_ONLY",
      "owner": "reference-source-resolution",
      "gate": "REFERENCE_RESOLVED",
      "requiredOutputs": [
        "buildMode",
        "referenceGate",
        "selectedReference",
        "authorityRationale"
      ],
      "next": [
        "DESIGN_DECISION",
        "EVIDENCE"
      ],
      "blockOn": [
        "BLOCKED_REFERENCE_AMBIGUOUS",
        "BLOCKED_REFERENCE_MISSING"
      ]
    },
    {
      "id": "DESIGN_DECISION",
      "state": "PLANNED",
      "mode": "READ_ONLY",
      "owner": "design-agent+skills",
      "gate": "DESIGN_DECISION_READY",
      "requiredOutputs": [
        "designDecision",
        "acceptanceCriteria",
        "knownUnknowns"
      ],
      "next": [
        "CHANGE_SCOPE",
        "EVIDENCE"
      ]
    },
    {
      "id": "CHANGE_SCOPE",
      "state": "PLANNED",
      "mode": "READ_ONLY",
      "owner": "controller",
      "gate": "SCOPE_RESOLVED",
      "requiredOutputs": [
        "allowedChanges",
        "protectedAreas",
        "outOfScope",
        "affectedStates",
        "affectedViewports",
        "dependentChangeRules"
      ],
      "next": [
        "WRITE_PERMISSION"
      ]
    },
    {
      "id": "WRITE_PERMISSION",
      "state": "READY_TO_EXECUTE",
      "mode": "READ_ONLY",
      "owner": "permission-controller",
      "gate": "WRITE_ALLOWED_OR_READ_ONLY_ROUTE",
      "requiredOutputs": [
        "permissionState",
        "permissionEvidence",
        "authorizedTarget",
        "authorizedScope"
      ],
      "next": [
        "PRE_WRITE_REVALIDATION",
        "EVIDENCE"
      ],
      "writeAllowedRequires": [
        "explicitWriteSignal",
        "targetResolved",
        "scopeResolved",
        "referenceEligible",
        "figmaWriteCapability"
      ]
    },
    {
      "id": "PRE_WRITE_REVALIDATION",
      "state": "REVALIDATING",
      "mode": "READ_ONLY",
      "owner": "figma-inspect+controller",
      "gate": "BASELINE_CURRENT",
      "requiredOutputs": [
        "freshFingerprint",
        "baselineComparison",
        "revalidationResult"
      ],
      "next": [
        "FIGMA_EXECUTION_PLAN",
        "FIGMA_INSPECT",
        "EVIDENCE"
      ],
      "results": [
        "CURRENT",
        "STALE_BASELINE",
        "BLOCKED"
      ],
      "staleRoute": "FIGMA_INSPECT"
    },
    {
      "id": "FIGMA_EXECUTION_PLAN",
      "state": "READY_TO_EXECUTE",
      "mode": "READ_ONLY",
      "owner": "figma-execution+design-agent",
      "gate": "EXECUTION_PLAN_READY",
      "requiredOutputs": [
        "operationPlan",
        "executionBatches",
        "verificationPlan",
        "recoveryHints"
      ],
      "next": [
        "MUTATION"
      ]
    },
    {
      "id": "MUTATION",
      "state": "EXECUTING",
      "mode": "WRITE_ALLOWED",
      "owner": "figma-capability",
      "gate": "MUTATION_RECORDED_OR_ERROR_CLASSIFIED",
      "requiredOutputs": [
        "createdNodeIds",
        "mutatedNodeIds",
        "executedOperations",
        "mutationOutcome"
      ],
      "next": [
        "VERIFICATION",
        "MUTATION_RECOVERY"
      ]
    },
    {
      "id": "MUTATION_RECOVERY",
      "state": "RECOVERING",
      "mode": "WRITE_ALLOWED_OR_READ_ONLY_INSPECT",
      "owner": "figma-execution+controller",
      "gate": "CANVAS_STATE_KNOWN",
      "requiredOutputs": [
        "errorClassification",
        "canvasWriteState",
        "recoveryPlan",
        "recoveryResult"
      ],
      "next": [
        "MUTATION",
        "VERIFICATION",
        "EVIDENCE"
      ],
      "canvasWriteStates": [
        "NO_WRITE",
        "PARTIAL_WRITE",
        "UNKNOWN_WRITE",
        "RECOVERED"
      ]
    },
    {
      "id": "VERIFICATION",
      "state": "VERIFYING",
      "mode": "READ_ONLY",
      "owner": "figma-inspect+figma-execution",
      "gate": "VERIFIED",
      "requiredOutputs": [
        "structuralEvidence",
        "visualEvidence",
        "scopeEvidence",
        "verificationStatus",
        "mismatchRecords"
      ],
      "next": [
        "QA_PRE_REGRESSION",
        "FIX_LOOP",
        "EVIDENCE"
      ]
    },
    {
      "id": "QA_PRE_REGRESSION",
      "state": "QA_PRE_REGRESSION",
      "mode": "READ_ONLY",
      "owner": "design-qa+specialist-skills",
      "gate": "QA_01_09_RESOLVED",
      "requiredOutputs": [
        "qa01to09Matrix",
        "defectRecords",
        "preRegressionResult"
      ],
      "next": [
        "VISUAL_REGRESSION",
        "FIX_LOOP",
        "EVIDENCE"
      ]
    },
    {
      "id": "VISUAL_REGRESSION",
      "state": "REGRESSION",
      "mode": "READ_ONLY",
      "owner": "visual-regression",
      "gate": "QA_10_RESOLVED",
      "requiredOutputs": [
        "baselineEvidence",
        "differenceRecords",
        "qa10Result"
      ],
      "next": [
        "FINAL_QA_AGGREGATION",
        "FIX_LOOP",
        "EVIDENCE"
      ]
    },
    {
      "id": "FINAL_QA_AGGREGATION",
      "state": "QA_FINAL",
      "mode": "READ_ONLY",
      "owner": "design-qa",
      "gate": "FINAL_QA_RESOLVED",
      "requiredOutputs": [
        "gateMatrixQA01to10",
        "finalQaResult",
        "p2Polish",
        "blockingDefects"
      ],
      "next": [
        "FIX_LOOP",
        "EVIDENCE"
      ]
    },
    {
      "id": "FIX_LOOP",
      "state": "FIXING",
      "mode": "WRITE_ALLOWED",
      "owner": "fix-loop+root-cause-skill+figma-execution",
      "gate": "FIXED_OR_BLOCKED",
      "requiredOutputs": [
        "fixIterations",
        "resolvedDefects",
        "remainingDefects",
        "affectedGates"
      ],
      "next": [
        "VERIFICATION",
        "EVIDENCE"
      ],
      "mandatoryReturnPath": [
        "VERIFICATION",
        "QA_PRE_REGRESSION",
        "VISUAL_REGRESSION",
        "FINAL_QA_AGGREGATION"
      ]
    },
    {
      "id": "EVIDENCE",
      "state": "EVIDENCE",
      "mode": "READ_ONLY",
      "owner": "evidence",
      "gate": "EVIDENCE_COMPLETE",
      "requiredOutputs": [
        "evidenceMatrix",
        "provenance",
        "resumeCheckpointIfBlocked",
        "finalAuditEnvelope"
      ],
      "next": [
        "COMPLETE"
      ]
    },
    {
      "id": "COMPLETE",
      "state": "COMPLETE",
      "mode": "READ_ONLY",
      "owner": "controller",
      "gate": "FINAL_RESULT_RESOLVED",
      "requiredOutputs": [
        "finalResult",
        "completionSummary"
      ],
      "finalStates": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  ],
  "commandStageRules": {
    "INSPECT": [
      "USER_REQUEST",
      "RESOLVE_INTENT",
      "LOAD_AGENT_SKILLS",
      "FIGMA_INSPECT",
      "EVIDENCE",
      "COMPLETE"
    ],
    "REVIEW": [
