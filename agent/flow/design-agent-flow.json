      "FIGMA_EXECUTION_PLAN",
      "MUTATION",
      "MUTATION_RECOVERY",
      "VERIFICATION",
      "QA_PRE_REGRESSION",
      "VISUAL_REGRESSION",
      "FINAL_QA_AGGREGATION",
      "FIX_LOOP",
      "EVIDENCE",
