  "invariants": [
    "exact_current_user_visual_ref_precedes_product_master_for_visual_authority",
    "prior_user_ref_missing_blocks_instead_of_fallback",
    "reference_lock_before_visual_grammar_and_design_decision",
    "system_authority_cannot_replace_locked_visual_composition",
    "visual_grammar_required_for_reference_reproduce",
    "reproduce_uses_skeleton_fidelity_checkpoint",
    "qa_01a_reference_authority_separate_from_qa_01b_visual_fidelity",
    "side_by_side_visual_evidence_required_for_reproduce_fidelity_pass",
    "no_mutation_before_inspection",
    "no_mutation_before_design_decision",
    "no_mutation_before_scope",
    "no_mutation_without_write_allowed",
    "pre_write_revalidation_required_for_writes",
    "tool_success_is_not_verification",
    "no_pass_without_evidence"
  ]
}
