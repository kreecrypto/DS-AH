  },
  "invariants": [
    "qa_01_09_before_qa_10",
    "final_qa_after_qa_10",
    "component_intent_has_machine_flow",
    "mutation_error_requires_canvas_state_classification",
    "blocked_runs_emit_resume_checkpoint",
    "stale_baseline_forces_reinspection",
    "specialized_subflows_must_not_bypass_parent_guards",
    "fix_loop_returns_through_verification_and_all_affected_qa",
    "no_mutation_before_inspection",
    "no_mutation_before_design_decision",
    "no_mutation_before_scope",
    "no_mutation_without_write_allowed",
    "pre_write_revalidation_required_for_writes",
    "tool_success_is_not_verification",
    "no_pass_without_evidence"
  ]
}
