  "schemas": {
    "execution": "agent/output/execution.schema.json",
    "decisionLog": "agent/output/decision-log.schema.json",
    "designDecision": "agent/planner/design-decision.schema.json",
    "changeScope": "agent/controller/change-scope.schema.json",
    "baselineFingerprint": "agent/output/baseline-fingerprint.schema.json",
    "referenceLock": "agent/reference/reference-lock.schema.json",
    "visualGrammar": "agent/planner/visual-grammar.schema.json",
    "designSystemMapping": "agent/planner/design-system-mapping.schema.json",
    "resumeCheckpoint": "agent/output/resume-checkpoint.schema.json",
    "qaResult": "agent/output/qa-result.schema.json",
    "evidenceMatrix": "agent/output/evidence-matrix.schema.json",
    "reviewResult": "agent/output/review-result.schema.json"
  },
  "qualityGates": "agent/gates/quality-gates.json",
  "invariants": [
    "figma_read_only_by_default",
    "exact_current_user_visual_ref_has_visual_authority_priority",
    "missing_requested_prior_ref_blocks_instead_of_master_fallback",
    "reference_lock_before_visual_grammar",
    "visual_grammar_before_design_decision",
    "system_mapping_preserves_locked_visual_role",
    "reproduce_skeleton_before_detail",
    "side_by_side_visual_evidence_for_reference_fidelity",
    "inspect_before_write",
    "baseline_before_write",
    "plan_before_execute",
    "scope_before_execute",
    "explicit_write_signal_required",
    "reference_pass_does_not_equal_write_permission",
    "pre_write_revalidation_required",
    "stale_baseline_forces_reinspection",
    "stale_reference_forces_reresolution",
    "mutation_error_requires_recovery_classification",
    "qa_01a_and_01b_separate",
    "pre_regression_before_qa_10",
    "final_qa_after_qa_10",
    "fix_loop_returns_through_verification_and_qa",
    "blocked_resumable_run_emits_checkpoint",
    "component_default_read_only",
    "specialized_subflows_cannot_bypass_parent_guards",
    "no_scope_expansion_for_visual_polish",
    "no_pass_without_evidence",
    "retrieve_before_design",
    "rank_references_before_lock_when_multiple_candidates_exist",
    "existing_product_screen_precedes_generic_design_knowledge",
    "resolve_archetype_before_screen_composition",
    "reuse_before_create",
    "instantiate_override_compose_before_custom_draw",
    "mutation_budget_prevents_scope_drift",
    "structure_pass_before_detail_passes",
    "visual_delta_is_patch_input_not_redraft_permission"
  ],
  "writeFidelity": {
    "version": "1.0.0",
    "flow": "agent/flow/write-fidelity-v2.json",
    "referenceResolver": "agent/reference/reference-resolver.json",
    "screenArchetypes": "agent/archetypes/screen-archetypes.json",
    "compositionKnowledgeSchema": "agent/composition/composition-knowledge.schema.json",
    "writePlanSchema": "agent/write/write-plan.schema.json",
    "visualDeltaPolicy": "agent/qa/visual-delta-policy.json",
    "mutationBudgetPolicy": "policies/mutation-budget.md",
    "reusePolicy": "policies/reuse-first-write.md",
    "compositionKnowledgeRegistry": "registry/composition-knowledge.json",
    "compositionKnowledgeIndex": "source/composition/admin-portal/index.json",
    "compositionRetrievalRule": "Load exact product composition when available; otherwise load archetype-compatible composition as composition-lane evidence only. Never infer business content from composition."
  }
}
