{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent/output/decision-log.schema.json",
  "title": "Design Agent Decision Log v2.4",
  "type": "object",
  "required": [
    "task",
    "sourceOfTruth",
    "reuseDecision",
    "writeMode",
    "openGaps"
  ],
  "properties": {
    "task": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "buildMode": {
      "enum": [
        "REPRODUCE",
        "ADAPT",
        "EXPLORE"
      ]
    },
    "referenceGate": {
      "enum": [
        "PASS",
        "BLOCKED_REFERENCE_AMBIGUOUS",
        "BLOCKED_REFERENCE_MISSING",
        "EXPLORE_EXPLICIT"
      ]
    },
    "referenceSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "referenceLockStatus": {
      "enum": [
        "LOCKED",
        "BLOCKED",
        "NOT_APPLICABLE",
        null
      ]
    },
    "visualAuthority": {
      "type": [
        "string",
        "null"
      ]
    },
    "systemAuthority": {
      "type": [
        "string",
        "null"
      ]
    },
    "visualGrammarStatus": {
      "enum": [
        "COMPLETE",
        "BLOCKED",
        "NOT_APPLICABLE",
        null
      ]
    },
    "designSystemMappingStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED",
        "NOT_APPLICABLE",
        null
      ]
    },
    "sourceOfTruth": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loadedSkills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coreComponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domainComponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reuseDecision": {
      "enum": [
        "REUSE",
        "EXTEND",
        "WRAP",
        "CREATE_DOMAIN",
        "CREATE_CORE",
        "SCREEN_ONLY",
        "REVIEW_REQUIRED"
      ]
    },
    "writeMode": {
      "enum": [
        "read-only",
        "explicit-write"
      ]
    },
    "referenceAuthorityQa": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "visualFidelity": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "finalResult": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "openGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
