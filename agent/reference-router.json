{
  "schemaVersion": "1.0.0",
  "buildModes": {
    "REPRODUCE": {
      "defaultWhen": "a matching approved/current Master Screen exists",
      "inventionAllowed": false
    },
    "ADAPT": {
      "defaultWhen": "the user requests changes to an existing design/reference",
      "inventionAllowed": "only inside explicitly requested scope"
    },
    "EXPLORE": {
      "defaultWhen": "the user explicitly requests a new concept/direction/from-scratch design",
